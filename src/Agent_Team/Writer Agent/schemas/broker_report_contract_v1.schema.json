{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Broker Report Contract v1",
  "type": "object",
  "required": [
    "render_targets",
    "report_metadata",
    "cover_summary",
    "investment_view",
    "key_metrics_table",
    "visual_report_blocks",
    "reader_friendly_sections",
    "sections",
    "limitations",
    "source_trace",
    "layout_plan",
    "validation_rules",
    "design_spec"
  ],
  "properties": {
    "render_targets": {
      "type": "object",
      "required": ["html_preview", "pdf_export", "default_render_format"]
    },
    "report_metadata": {
      "type": "object",
      "required": ["company_name", "base_date", "recommendation", "target_price", "valuation_status"]
    },
    "cover_summary": {"type": "object"},
    "investment_view": {"type": "object"},
    "key_metrics_table": {
      "type": "object",
      "required": ["metrics"]
    },
    "visual_report_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "block_id",
          "section",
          "figure_id",
          "figure_path",
          "figure_path_png",
          "html_img_path",
          "figure_title",
          "display_title",
          "caption",
          "what_chart_shows",
          "analyst_takeaway",
          "linked_strategy_fields",
          "interpretation_limit"
        ]
      }
    },
    "reader_friendly_sections": {
      "type": "object",
      "required": [
        "investment_summary",
        "financial_view_cards",
        "market_view_cards",
        "catalyst_analysis_cards",
        "risk_cards",
        "final_rationale"
      ]
    },
    "sections": {"type": "object"},
    "limitations": {"type": "object"},
    "source_trace": {"type": "array"},
    "layout_plan": {"type": "object"},
    "validation_rules": {"type": "object"},
    "design_spec": {"type": "object"}
  }
}
